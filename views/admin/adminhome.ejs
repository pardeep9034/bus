<% layout("/layout/admin") %>
<body>
  <div class="container-fluid ">
    <!-- Dashboard Header -->
    <!-- <header class="d-flex justify-content-between align-items-center bg-primary text-white py-3 px-4">
      <h1 class="fw-bold">Admin Dashboard</h1>
      <button class="btn btn-light">Logout</button>
    </header> -->

    <!-- Dashboard Content -->
    <div class="dashboard-grid mt-3 px-4">
      <!-- Metrics Section -->
      <div class="metrics bg-light shadow-sm rounded p-3">
        <h5 class="fw-bold mb-3">Quick Stats</h5>
        <div class="row text-center">
          <div class="col-6 col-md-3">
            <div class="metric-card">
              <h3 class="text-primary">500</h3>
              <p>Total Users</p>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="metric-card">
              <h3 class="text-success">200</h3>
              <p>Registered</p>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="metric-card">
              <h3 class="text-danger">300</h3>
              <p>Unregistered</p>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="metric-card">
              <h3 class="text-warning">50</h3>
              <p>Pending Approvals</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Users and Registrations Chart -->
      <div class="chart bg-light shadow-sm rounded p-3">
        <h5 class="fw-bold text-center">Users and Registrations</h5>
        <canvas id="usersChart"></canvas>
      </div>

      <!-- Registration Breakdown Chart -->
      <div class="chart bg-light shadow-sm rounded p-3">
        <h5 class="fw-bold text-center">Registration Breakdown</h5>
        <canvas id="registrationChart"></canvas>
      </div>

      <!-- Recent Activities -->
      <div class="recent-activities bg-light shadow-sm rounded p-3">
        <h5 class="fw-bold">Recent Activities</h5>
        <ul class="list-group">
          <li class="list-group-item">User John registered for Route 5</li>
          <li class="list-group-item">New user Sarah signed up</li>
          <li class="list-group-item">Admin approved Route 7 registrations</li>
          <li class="list-group-item">5 new users pending approval</li>
        </ul>
      </div>

      <!-- Tasks Section -->
      <div class="tasks bg-light shadow-sm rounded p-3">
        <h5 class="fw-bold">Admin Tasks</h5>
        <ul class="list-group">
          <li class="list-group-item">
            <input type="checkbox" class="form-check-input me-2"> Approve pending registrations
          </li>
          <li class="list-group-item">
            <input type="checkbox" class="form-check-input me-2"> Update route schedules
          </li>
          <li class="list-group-item">
            <input type="checkbox" class="form-check-input me-2"> Review user feedback
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Scripts Section -->
  <script>
    // Mock data for demonstration
    const usersCount = 500;
    const registeredCount = 200;
    const unregisteredCount = 300;

    // Users and Registrations Chart
    const usersChart = new Chart(document.getElementById('usersChart'), {
      type: 'bar',
      data: {
        labels: ['Total Users', 'Registered Users'],
        datasets: [{
          label: 'Users Count',
          data: [usersCount, registeredCount],
          backgroundColor: ['#007bff', '#28a745']
        }]
      },
      options: {
        responsive: true,
        scales: {
          y: { beginAtZero: true }
        }
      }
    });

    // Registration Breakdown Chart
    const registrationChart = new Chart(document.getElementById('registrationChart'), {
      type: 'doughnut',
      data: {
        labels: ['Registered', 'Unregistered'],
        datasets: [{
          data: [registeredCount, unregisteredCount],
          backgroundColor: ['#28a745', '#dc3545']
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { position: 'bottom' }
        }
      }
    });
  </script>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Custom CSS -->
  <style>
    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 20px;
    }

    .metrics {
      grid-column: span 12;
    }

    .chart {
      grid-column: span 6;
    }

    .recent-activities {
      grid-column: span 4;
    }

    .tasks {
      grid-column: span 4;
    }

    .metric-card h3 {
      font-size: 2rem;
    }

    .metric-card p {
      margin: 0;
    }

    @media (max-width: 768px) {
      .dashboard-grid {
        grid-template-columns: 1fr;
      }

      .chart, .recent-activities, .tasks {
        grid-column: span 12;
      }
    }
  </style>
</body>
